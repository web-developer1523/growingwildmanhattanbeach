{% comment %} <section class="{{ section.settings.custom_css_class }} page-width">
  <h2>{{ section.settings.heading }}</h2>

  <div class="cst-blooms-main">
    <div class="cst-blooms-para" >
      {% for block in section.blocks %}
        <p>{{ block.settings.feature }}</p>
      {% endfor %}
    </div>

    <div class="cst-blooms-img">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | image_url: width: 300 }}" alt="">
      {% endif %}

      {% for block in section.blocks %}
        <p>✔</p>
      {% endfor %}
    </div>

    <div class="cst-blooms-img2>
      {% if section.settings.other_image != blank %}
        <img src="{{ section.settings.other_image | image_url: width: 200 }}" alt="">
      {% endif %}

      {% for block in section.blocks %}
        <p>✖</p>
      {% endfor %}
    </div>
  </div>

  {% comment %} <a href="{{ section.settings.button_link }}">
    {{ section.settings.button_text }}
  </a> {% endcomment %}
  {% comment %} buton {% endcomment %}
    {% if product != blank %}

  {% assign product_form_id = 'product-form-' | append: product.id %}

  {% form 'product', product, id: product_form_id %}

    <buy-buttons class="buy-buttons"
      template="{{ product.template_suffix | escape }}"
      form="{{ product_form_id }}">

      {%- liquid
        assign button_disabled = false
        assign button_style = 'solid'

        if product.selected_or_first_available_variant == nil
          assign button_disabled = true
          assign button_style = 'outline'
          assign button_content = 'product.general.unavailable_button' | t
        elsif product.selected_or_first_available_variant.available == false
          assign button_disabled = true
          assign button_style = 'outline'
          assign button_content = 'product.general.sold_out_button' | t
        else
          if product.template_suffix contains 'pre-order'
            assign button_content = 'product.general.pre_order_button' | t
          else
            assign button_content = 'product.general.add_to_cart_button' | t
          endif
        endif
      -%}

      {%- render 'button',
        content: button_content,
        style: button_style,
        type: 'submit',
        form: product_form_id,
        disabled: button_disabled
      -%}

    </buy-buttons>

  {% endform %}

{% endif %}

  {% comment %} button end {% endcomment %}
  <div class="cst-blooms-top">
    <div class="blooms-top-img">
      {% if section.settings.delivery_icon != blank %}
        <img src="{{ section.settings.delivery_icon | image_url: width: 40 }}" alt="">
      {% endif %}
      <span>{{ section.settings.delivery_text }}</span>
    </div>

    <span>|</span>

    <div class="blooms-main-image">
      {% if section.settings.guarantee_icon != blank %}
        <img src="{{ section.settings.guarantee_icon | image_url: width: 40 }}" alt="">
      {% endif %}
      <span>{{ section.settings.guarantee_text }}</span>
    </div>
  </div>

  <div class="cst-blooms-reviews">
    ⭐ {{ section.settings.review_text }}
  </div>
</section>

{% schema %}
{
  "name": "Blooms Comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Our Blooms Compare to Others"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Brand Image"
    },
    {
      "type": "image_picker",
      "id": "other_image",
      "label": "Other Florists Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "delivery_icon",
      "label": "Fast Delivery Icon"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Fast Delivery Text",
      "default": "Fast Nationwide Delivery"
    },
    {
      "type": "image_picker",
      "id": "guarantee_icon",
      "label": "Guarantee Icon"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "Satisfaction Guarantee"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "Loved by 10,000+ Happy Customers"
    },
    {
    "type": "text",
    "id": "custom_css_class",
    "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Text",
          "default": "Fresh, Premium Blooms"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Blooms Comparison",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}
<section class="compare-blooms">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="compare-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  <div class="main-wrap-table">
    <div class="compare-table">

      <!-- LEFT COLUMN (FEATURES) -->
      <div class="compare-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature-text">
              {{ block.settings.feature_text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- CENTER COLUMN (YOUR BRAND) -->
      <div class="compare-column highlight">
        {% if section.settings.left_image %}
          <img src="{{ section.settings.left_image | image_url: width: 400 }}" alt="">
        {% endif %}
        <h4>{{ section.settings.left_title }}</h4>

      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="icon-border-check">
          <div class="compare-icon compare-icon--check"></div>
          </div>
        {% endif %}
      {% endfor %}
      </div>

      <!-- RIGHT COLUMN (OTHERS) -->
      <div class="compare-column cst-compare-column">
        {% if section.settings.right_image %}
          <img src="{{ section.settings.right_image | image_url: width: 400 }}" alt="">
        {% endif %}
        <h4>{{ section.settings.right_title }}</h4>

     {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="icon-border">
          <div class="compare-icon compare-icon--cross"></div>
          </div>
        {% endif %}
      {% endfor %}
      </div>

    </div>
  </div>

    <!-- BUTTON -->
    {% if section.settings.button_label != blank %}
      <div class="compare-button">
        <a href="{{ section.settings.button_link }}" class="btn">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

    <!-- BOTTOM ICON ROW -->
    <div class="compare-bottom cst-compare-bottom">
      {% for block in section.blocks %}
        {% if block.type == 'bottom_icon' %}
          <div class="bottom-item">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | image_url: width: 50 }}" alt="">
            {% endif %}
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- REVIEWS -->
    {% if section.settings.review_text != blank %}
      <div class="compare-review">
        {{ section.settings.review_text }}
      </div>
    {% endif %}

  </div>
</section>

 <style>
{% comment %} .compare-blooms { padding: 60px 20px; background: #f7f3ef; }
.compare-heading { text-align: center; font-size: 32px; margin-bottom: 40px; }

.compare-table {
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 895px;
    margin: 0 auto;
}

.compare-features .feature-text {
    padding: 14px 25px;
    border-bottom: 1px solid #ddd;
}
.compare-column.highlight img {
    transform: translateY(-42px);
}
.compare-features:first-child {
    border-top: 1px solid #ddd;
}
.cst-compare-column img {
    max-width: 100% !important;
    margin: 0 auto !important;
    
}

.compare-column {
    text-align: center;
    width: 40%;
}
.cst-compare-column h4 {
    border-bottom: 1px solid #ddd;
    padding-bottom: 10px;
}

.compare-column.highlight {
    background: #fff;
    padding: 0;
    border-radius: 12px;
    width: 180px;
    margin-top:25px;
}
.highlight .icon {
    border-bottom: 0;
}
.compare-features {
    margin-top: 177px;
    width: 40%;
}

.cst-compare-column img {
  max-width: 120px;
  margin-bottom: 10px;
}

.icon {
  padding: 14px 0;
  border-bottom: 1px solid #ddd;
  font-size: 14px;
}

.icon.check { color: #111; }
.icon.cross { color: #d44; }

.compare-button {
  text-align: center;
  margin: 60px 0 20px;
}

.compare-button .btn {
    position: relative;
    overflow: hidden;
    background: #6a6e49;
    padding: 20px 12px;
    border: 1px solid #6A6E49;
    border-radius: 50px;
    color: #fff;
    width: 100%;
    text-align: center;
    cursor: pointer;
    display: inline-block;
    font-family: Scto Grotesk A;
    font-weight: 500;
    font-size: 18px;
    line-height: 18px;
    transition: color .4s ease, border-color .6s ease;
    z-index: 1;
}
.compare-button .btn::before{
      content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .6s ease;
    z-index: -1;
}
.compare-button .btn:hover::before{

}
.compare-button .btn:hover{
   border: 1px solid #6A6E49;
   color: #6A6E49;
}
.compare-bottom {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin-top: 20px;
}

.bottom-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.compare-review {
  text-align: center;
  margin-top: 15px;
  font-size: 14px;
  color: #555;
}

@media(max-width: 768px) {
  .compare-table {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .compare-features { display: none; }
} {% endcomment %}

.compare-icon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 14px auto;
  font-size: 14px;
  font-weight: bold;
}

/* LEFT COLUMN – BLACK CHECK */
.compare-icon--check {
  background-color: #111;
  color: #fff;
}

.compare-icon--check::before {
  content: "✓";
}

/* RIGHT COLUMN – OUTLINED CROSS */
.compare-icon--cross {
  background-color: #fff;
  border: 2px solid #ff6b5a;
  color: #ff6b5a;
}

.compare-icon--cross::before {
  content: "✕";
}
</style> 

