{{ 'component-card.css' | asset_url | stylesheet_tag }}

<style>
  .three-product-showcase {
    padding: 40px 0;
  }

  .three-product-showcase__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .three-product-showcase__heading {
     font-family: var(--heading-font-family, serif);
    text-align: center;
    margin-bottom: 40px;
    font-size: 2.5rem;
  }

  .three-product-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .three-product-showcase__card {
    text-align: center;
  }

  .three-product-showcase__image-wrapper {
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
    background-color: #f5f5f5;
    /* This creates a square aspect ratio box for the image */
    aspect-ratio: 1 / 1; 
  }

  .three-product-showcase__image-wrapper img,
  .three-product-showcase__image-wrapper .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease; /* Optional: Add a subtle zoom on hover */
  }

  .three-product-showcase__image-wrapper:hover img {
    transform: scale(1.05); /* Optional: Zoom effect */
  }

  .three-product-showcase__product-title {
       font-family: var(--heading-font-family, serif);
    font-weight: var(--heading-font-weight, 400);
    font-size: 2rem;
    font-weight: 500;
    color: #121212;
    text-decoration: none;
    display: inline-block; /* Helps with spacing */
    margin-top: 10px;
     
  }

  .three-product-showcase__product-title:hover {
    text-decoration: none;
  }

  /* Responsive adjustments for mobile */
  @media (max-width: 768px) {
    .three-product-showcase__grid {
      grid-template-columns: 1fr;
    }

    .three-product-showcase__heading {
      font-size: 2rem;
    }
  }
</style>

<div class="three-product-showcase">
  <div class="three-product-showcase__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="three-product-showcase__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="three-product-showcase__grid">
      {%- for i in (1..3) -%}
        {%- assign product_setting = 'product_' | append: i -%}
        {%- assign product = section.settings[product_setting] -%}
        
        <div class="three-product-showcase__card">
          <a href="{{ product.url | default: '#' }}" aria-label="{{ product.title | default: 'Product' | escape }}">
            <div class="three-product-showcase__image-wrapper">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ 400 | divided_by: product.featured_image.aspect_ratio | round }}"
                  class="three-product-showcase__image"
                >
              {%- else -%}
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </a>
          <a href="{{ product.url | default: '#' }}" class="three-product-showcase__product-title">
            {{ product.title | default: 'Product Title' }}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three Product Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Subscriptions"
    },
    {
      "type": "header",
      "content": "Product Column 1"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Select Product"
    },
    {
      "type": "header",
      "content": "Product Column 2"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Select Product"
    },
    {
      "type": "header",
      "content": "Product Column 3"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Select Product"
    }
  ],
  "presets": [
    {
      "name": "Three Product Showcase"
    }
  ]
}
{% endschema %}