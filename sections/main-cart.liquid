<script>
  var checkoutUrl = "/checkout";
  document.addEventListener('DOMContentLoaded', function () {
    var popup = document.getElementById('deliveryBillingPopup');
    if (!popup) return;

    var closeBtn = document.getElementById('deliveryPopupClose');
    var dontShowCheckbox = document.getElementById('deliveryPopupDontShow');
    var overlay = popup.querySelector('[data-popup-overlay]');
    var checkoutForm = document.querySelector('form.cart-page');
    var checkoutBtn = document.querySelector('button[name="checkout"]');
    
    if (!checkoutForm || !checkoutBtn) return;

    // Store the original form action
    var originalFormAction = checkoutForm.action;

    function isHiddenPersisted() {
      try {
        return window.localStorage && localStorage.getItem('hideDeliveryPopup') === '1';
      } catch (e) {
        return false;
      }
    }

    function showPopup() {
      popup.classList.remove('hidden');
      popup.setAttribute('aria-hidden', 'false');
      closeBtn && closeBtn.focus();
    }

    function hidePopup() {
      popup.classList.add('hidden');
      popup.setAttribute('aria-hidden', 'true');
    }

    // Completely override the form submission
    checkoutForm.addEventListener('submit', function (e) {
      // If popup is permanently hidden, allow normal submission
      if (isHiddenPersisted()) {
        return true;
      }
      
      // Always prevent default form submission
      e.preventDefault();
      
      // Show the popup
      showPopup();
      
      return false;
    });

    // Handle checkout button click separately
    checkoutBtn.addEventListener('click', function (e) {
      // If popup is permanently hidden, let the form submit normally
      if (isHiddenPersisted()) {
        return true;
      }
      
      // Prevent default
      e.preventDefault();
      e.stopPropagation();
      
      // Show popup
      showPopup();
      
      return false;
    });

    // Handle close button click
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        // Save preference if checkbox is checked
        if (dontShowCheckbox && dontShowCheckbox.checked && window.localStorage) {
          try { 
            localStorage.setItem('hideDeliveryPopup', '1'); 
          } catch (e) {}
        }
        
        // Hide popup
        hidePopup();
        
        // Now manually submit the form to checkout
        // Use the original form action
        window.location.href = checkoutUrl;
      });
    }

    // Handle overlay click
    if (overlay) {
      overlay.addEventListener('click', function () {
        hidePopup();
      });
    }

    // Prevent any other click events on the form from submitting
    checkoutForm.addEventListener('click', function (e) {
      // If the clicked element is not the checkout button and not within the popup
      if (!e.target.closest('button[name="checkout"]') && !e.target.closest('.delivery-popup')) {
        return;
      }
      
      // If it's the checkout button and popup is not permanently hidden
      if (e.target.closest('button[name="checkout"]') && !isHiddenPersisted()) {
        e.preventDefault();
        e.stopPropagation();
        showPopup();
        return false;
      }
    }, true); // Use capture to ensure we get the event first

    // Disable any JavaScript that might be auto-submitting the form
    var originalSubmit = checkoutForm.submit;
    checkoutForm.submit = function() {
      // Only allow submit if popup is permanently hidden
      if (isHiddenPersisted()) {
        return originalSubmit.apply(this, arguments);
      }
      console.log('Form submission blocked until popup is acknowledged');
      showPopup();
    };

    // Reset on cart updates
    document.addEventListener('cart:updated', function () {
      // No need to do anything special
    });

  });
</script>


{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "shopify-section--main-cart",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.main_cart.show_cart_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_order_weight",
      "label": "t:sections.main_cart.show_order_weight",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "t:sections.main_cart.show_shipping_text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated_buttons",
      "label": "t:sections.main_cart.show_accelerated_buttons",
      "info": "t:sections.main_cart.show_accelerated_buttons_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "t:sections.main_cart.show_shipping_estimator",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_delivery_popup",
      "label": "Show delivery/billing popup",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_popup_title",
      "label": "Popup title",
      "default": "Important: Delivery vs Billing"
    },
    {
      "type": "richtext",
      "id": "delivery_recipient_text",
      "label": "Recipient (Delivery Details) text",
      "default": "<p><strong>Recipient (Delivery Details)</strong> — Who will receive the flowers and where. Enter the recipient's full name and the complete delivery address so the flowers arrive at the right place.</p>"
    },
    {
      "type": "richtext",
      "id": "delivery_billing_text",
      "label": "Billing (Your Details) text",
      "default": "<p><strong>Billing (Your Details)</strong> — The person paying and their billing address. This is used for payment and receipts and may differ from the delivery address.</p>"
    },
    {
      "type": "richtext",
      "id": "delivery_reminder_text",
      "label": "Reminder text",
      "default": "<p><strong>Reminder:</strong> Please double-check the delivery address to avoid incorrect delivery.</p>"
    },
    {
      "type": "text",
      "id": "delivery_button_label",
      "label": "Button label",
      "default": "Got it"
    },
    {
      "type": "text",
      "id": "delivery_dont_show_text",
      "label": "Don't show again label",
      "default": "Don't show again"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

