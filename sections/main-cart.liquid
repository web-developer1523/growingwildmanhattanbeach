<style>
  /* Minimalist popup styling to match site aesthetic */
  .delivery-popup.hidden { display: none; }

  .delivery-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-family: inherit;
  }

  .delivery-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 15, 0.28);
    backdrop-filter: blur(4px);
  }

  .delivery-popup__content {
    position: relative;
    background: var(--surface, #ffffff);
    color: var(--text, #0f1720);
    max-width: 480px;
    width: 100%;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(16, 24, 32, 0.04);
    box-shadow: 0 8px 24px rgba(16, 24, 32, 0.08);
    z-index: 1;
    text-align: left;
  }

  .delivery-popup__content h2 {
    margin: 0 0 8px;
    font-size: 26px;
    font-weight: 600;
    text-align: center;
  }

  .delivery-popup__text p {
    margin: 12px 0;
    color: var(--muted, #000);
    line-height: 1.45;
    font-size: 16px;
}

  .delivery-popup__reminder {
    margin-top: 10px;
    color: #b21f2d;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .delivery-popup__actions {
    display: grid;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }

  .checkbox-inline {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted, #475569);
    font-size: 0.9rem;
  }

  .checkbox-inline input { width: 16px; height: 16px; }

  #deliveryPopupClose {
    background: #6a6e49;
    color: #fff;
    border: none;
    padding: 10px 24px;
    cursor: pointer;
    font-weight: 600;
    box-shadow: none;
    border: 1px solid #6a6e49;
    width: 30%;
    margin: 0 auto;
}

  #deliveryPopupClose:hover {
    opacity: 1;
    transform: translateY(-1px);
    border: 1px solid #6a6e49;
    color: #6a6e49;
}

  @media (max-width: 480px) {
    .delivery-popup__content { padding: 16px; border-radius: 10px; }
    .delivery-popup { padding: 12px; }
    .delivery-popup__actions { gap: 8px; }
  }
</style>

