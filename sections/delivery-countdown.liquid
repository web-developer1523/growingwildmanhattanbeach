{% if section.settings.enable_timer %}
<style>
.delivery-timer-wrapper {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: 12px 16px;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  font-weight: 600;
  flex-wrap: wrap;
}

.timer-heading {
  max-width: 70%;
  font-size: 25px;
  font-family: CooperBT-Light;
    font-weight: 400;
}

.timer-box {
  display: flex;
  gap: 8px;
}

.timer-group {
  text-align: center;
}

.timer-number {
  background: {{ section.settings.timer_bg }};
  color: {{ section.settings.timer_text }};
  padding: 4px 6px;
  font-size: 14px;
  min-width: 28px;
}

.timer-label {
  font-size: 10px;
}
</style>

<div
  class="delivery-timer-wrapper"
  id="delivery-timer-{{ section.id }}"
  data-cutoff-hour="{{ section.settings.cutoff_hour }}"
  data-cutoff-minute="{{ section.settings.cutoff_minute }}"
>
  <div class="timer-heading">
    {{ section.settings.heading }}
  </div>

  <div class="timer-box">
    <div class="timer-group">
      <div class="timer-number" id="hours-{{ section.id }}">00</div>
      <div class="timer-label">HOURS</div>
    </div>
    <div class="timer-group">
      <div class="timer-number" id="minutes-{{ section.id }}">00</div>
      <div class="timer-label">MINS</div>
    </div>
    <div class="timer-group">
      <div class="timer-number" id="seconds-{{ section.id }}">00</div>
      <div class="timer-label">SECS</div>
    </div>
  </div>
</div>

<script>
(function () {
  function startTimer(sectionId) {
    const timer = document.getElementById('delivery-timer-' + sectionId);
    if (!timer) return;

    const cutoffHour = parseInt(timer.dataset.cutoffHour, 10);
    const cutoffMinute = parseInt(timer.dataset.cutoffMinute, 10);

    const hEl = document.getElementById('hours-' + sectionId);
    const mEl = document.getElementById('minutes-' + sectionId);
    const sEl = document.getElementById('seconds-' + sectionId);

    function updateTimer() {
      const now = new Date();
      const cutoff = new Date();
      cutoff.setHours(cutoffHour, cutoffMinute, 0, 0);

      if (now >= cutoff) {
        timer.style.display = 'none';
        return;
      }

      const diff = cutoff - now;

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      hEl.textContent = String(hours).padStart(2, '0');
      mEl.textContent = String(minutes).padStart(2, '0');
      sEl.textContent = String(seconds).padStart(2, '0');
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  }

  // Run on page load
  startTimer('{{ section.id }}');

  // Run again when section reloads in theme editor
  document.addEventListener('shopify:section:load', function (event) {
    if (event.target.querySelector('#delivery-timer-{{ section.id }}')) {
      startTimer('{{ section.id }}');
    }
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Delivery Countdown Timer",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_timer",
      "label": "Enable countdown timer",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Want your arrangement today? Same-day delivery ends soon!"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Cutoff hour (24h format)",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "cutoff_minute",
      "label": "Cutoff minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7a600"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "timer_bg",
      "label": "Timer box background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "timer_text",
      "label": "Timer text color",
      "default": "#f7a600"
    }
  ],
  "presets": [
    {
      "name": "Delivery Countdown Timer"
    }
  ]
}
{% endschema %}
