{% schema %}
{
  "name": "Summer Event CTA",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient (if no image)",
      "default": "linear-gradient(135deg, #ffdb58 0%, #ffbb33 100%)"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN OUR SUMMER EVENTS"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "Be part of something energizing. Join us this summer at Maslow's Members' House in Soho — experience scent, movement, and mindset in a live, immersive ritual."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#3B1D1D"
    }
  ],
  "presets": [
    {
      "name": "Summer Event CTA",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<div class="summer-cta-wrapper-{{ section.id }}">
  <div class="summer-cta-container">
    <div class="summer-cta-content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
      
      <a href="{{ section.settings.btn_link | default: '#' }}" class="summer-cta-btn">
        {{ section.settings.btn_label }}
      </a>
      
    </div>
  </div>
</div>

<style>
  /* Ensure Larken font is applied if available in theme assets */
  h2, .summer-cta-btn {
    font-family: 'Larken', serif;
  }

  .summer-cta-wrapper-{{ section.id }} {
    padding: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .summer-cta-wrapper-{{ section.id }} .summer-cta-container {
    /* Logic: Use image if available, otherwise use gradient */
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1600 }}');
    {% else %}
      background: {{ section.settings.bg_gradient }};
    {% endif %}
    
    background-size: cover;
    background-position: center;
    border-radius: 20px;
    padding: 80px 20px;
    text-align: center;
    color: {{ section.settings.text_color }};
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .summer-cta-wrapper-{{ section.id }} h2 {
    font-size: 36px;
    font-weight: 700;
    margin: 0 0 15px 0;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
  }

  .summer-cta-wrapper-{{ section.id }} p {
    font-family: inherit; /* Keeps body text standard */
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 35px 0;
    color: {{ section.settings.text_color }};
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* The Shop Now Button Style */
  .summer-cta-wrapper-{{ section.id }} .summer-cta-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 15px 45px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 18px; /* Slightly larger for emphasis */
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    line-height: 1;
    
    /* This creates the subtle bottom lip/shadow seen in your screenshot */
    box-shadow: 0 4px 10px rgba(0,0,0,0.15); 
  }

  .summer-cta-wrapper-{{ section.id }} .summer-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.2);
  }
  
  .summer-cta-wrapper-{{ section.id }} .summer-cta-btn:active {
    transform: translateY(1px);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  @media (max-width: 768px) {
    .summer-cta-wrapper-{{ section.id }} .summer-cta-container {
      padding: 50px 15px;
    }
    .summer-cta-wrapper-{{ section.id }} h2 {
      font-size: 28px;
    }
    .summer-cta-wrapper-{{ section.id }} p {
      font-size: 15px;
    }
    .summer-cta-wrapper-{{ section.id }} .summer-cta-btn {
        padding: 14px 35px;
        font-size: 16px;
    }
  }
</style>