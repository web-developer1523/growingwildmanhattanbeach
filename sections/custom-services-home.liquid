<section class="services-section {{ section.settings.custom_class }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="services-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="services-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="service-card" {{ block.shopify_attributes }}>
          
          {% if block.settings.image != blank %}
            <div class="service-image">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          <div class="service-content">
            {% if block.settings.subheading != blank %}
              <span class="service-subheading">
                {{ block.settings.subheading }}
              </span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="service-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            <div class="service-link">
              <span class="service-icon">→</span>
              <span>{{ block.settings.link_text }}</span>
            </div>
          </div>

        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% comment %} <style>
.services-section {
    padding: 70px 48px;
    background: #fff;
}

.cst-service .services-heading {
    margin-bottom: 40px;
    font-family: CooperBT-Light;
    font-weight: 400;
    font-size: 42px;
    line-height: 51px;
    text-align: center;
    color: #27272a;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.service-card {
  text-decoration: none;
  color: inherit;
  display: block;
}

.service-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 12px;
}

.service-content {
  padding-top: 20px;
}

.cst-service .service-subheading {
    font-family: Scto Grotesk A;
    font-weight: 400;
    font-size: 13.63px;
    line-height: 140%;
    text-transform: uppercase;
    color: #27272a;
}

.cst-service .service-title {
    font-family: CooperBT-Light;
    font-weight: 400;
    font-size: 23.37px;
    line-height: 29.21px;
    letter-spacing: -.49px;
    vertical-align: middle;
    color: #27272a;
    padding: 8px 0 15px;
}

.service-link {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
}

.service-icon {
  width: 36px;
  height: 36px;
  border: 1px solid #6b6f4a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.service-card:hover .service-icon {
    background: #6b6f4a;
    color: #fff;
}

@media (max-width: 990px) {
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
}
</style> {% endcomment %}

{% schema %}
{
  "name": "Services Cards",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Services We Offer"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "VENUE STYLING & DECOR"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wedding Floral Design"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Explore services"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services cards",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
