{%- comment %} ----- START: Same Day Delivery Logic ----- {% endcomment %}

<style>
  /* CSS to hide the same-day delivery badge by default */
  .same-day-delivery-badge {
    display: none;
  }
  
  /* NEW: Style for the badge container */
  .card_badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    align-items: center;
    margin-top: 12px; /* Adds space above the badges */
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function handleSameDayDeliveryVisibility() {
      try {
        const storeTimeZone = 'America/Los_Angeles';
        
        // =================================================================
        // !! LIVE STORE HOURS !!
        // Opening time is now 12:05 AM.
        // =================================================================
        const openHour = 0;   // 12 AM in 24-hour format
        const openMinute = 5;  // 05 minutes past the hour
        const closeHour = 16;  // 4 PM in 24-hour format

        // Get the current date and time, including the minute
        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
          timeZone: storeTimeZone,
          weekday: 'short',
          hour: '2-digit',
          minute: '2-digit', // We need the minute now
          hour12: false
        });

        const parts = formatter.formatToParts(now);
        let day, hour, minute;

        parts.forEach(part => {
          if (part.type === 'weekday') { day = part.value; }
          if (part.type === 'hour') { hour = parseInt(part.value, 10); }
          if (part.type === 'minute') { minute = parseInt(part.value, 10); }
        });
        
        // Convert current time and store hours to total minutes from midnight for easy comparison
        const nowInMinutes = (hour * 60) + minute;
        const openTimeInMinutes = (openHour * 60) + openMinute; // This will be 5
        const closeTimeInMinutes = (closeHour * 60);             // This will be 960

        const businessDays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

        // Check if it's a business day and within the minute-precise time window
        if (businessDays.includes(day) && nowInMinutes >= openTimeInMinutes && nowInMinutes < closeTimeInMinutes) {
          const badges = document.querySelectorAll('.same-day-delivery-badge');
          badges.forEach(badge => {
            badge.style.display = 'flex';
          });
        }
      } catch (error) {
        console.error('Error handling same-day delivery visibility:', error);
      }
    }

    handleSameDayDeliveryVisibility();

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', handleSameDayDeliveryVisibility);
      document.addEventListener('shopify:section:select', handleSameDayDeliveryVisibility);
    }
  });
</script>

{%- comment %} ----- END: Same Day Delivery Logic ----- {% endcomment %}


