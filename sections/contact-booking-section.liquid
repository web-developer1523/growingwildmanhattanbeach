<div class="cbs-section">
  <div class="cbs-container">
    
    <!-- LEFT COLUMN: Contact Info -->
    <div class="cbs-left">
      <p class="cbs-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="cbs-heading">{{ section.settings.heading_left }}</h2>

      <!-- Card 1: Email (CLICKABLE) -->
      <div class="cbs-contact-card">
        <div class="cbs-icon">
           <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <div class="cbs-card-content">
          <h4>{{ section.settings.email_label }}</h4>
          <p>
            <a href="mailto:{{ section.settings.email_text }}" class="cbs-link">
              {{ section.settings.email_text }}
            </a>
          </p>
        </div>
      </div>

      <!-- Card 2: Phone (CLICKABLE) -->
      <div class="cbs-contact-card">
        <div class="cbs-icon">
           <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <div class="cbs-card-content">
          <h4>{{ section.settings.phone_label }}</h4>
          <p>
            {%- comment -%} Strip text so the phone link works properly {%- endcomment -%}
            {% assign clean_phone = section.settings.phone_text | split: '—' | first | remove: '(' | remove: ')' | remove: ' ' | remove: '-' %}
            <a href="tel:{{ clean_phone }}" class="cbs-link">
              {{ section.settings.phone_text }}
            </a>
          </p>
        </div>
      </div>

      <!-- Card 3: Address (SPECIFIC URL) -->
      <div class="cbs-contact-card">
        <div class="cbs-icon">
           <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <div class="cbs-card-content">
          <h4>{{ section.settings.addr_label }}</h4>
          <p>
            {% comment %} 
              If user provides a custom URL in settings, use it. 
              Otherwise fallback to a generic search for the address text.
              Note: I've added your specific URL as a fallback below if the setting is empty.
            {% endcomment %}
            {% assign map_link = section.settings.addr_url %}
            {% if map_link == blank %}
               {% assign map_link = "https://www.google.com/maps/place/Growing+Wild/@33.8858057,-118.4102397,16z/data=!4m6!3m5!1s0x80c2b3ec78548b67:0xb63e5351abcac295!8m2!3d33.8858057!4d-118.4102397!16s%2Fg%2F1tfc6wf9" %}
            {% endif %}
            
            <a href="{{ map_link }}" target="_blank" class="cbs-link">
              {{ section.settings.addr_text }}
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Form -->
    <div class="cbs-right">
      <div class="cbs-form-header">
        <h3 class="cbs-form-title">{{ section.settings.form_title }}</h3>
        <p class="cbs-form-sub">{{ section.settings.form_sub }}</p>
      </div>

      {% form 'contact' %}
        
        {% if form.posted_successfully? %}
          <p style="color: green; font-weight: bold; margin-bottom: 20px;">Thanks for contacting us! We'll get back to you shortly.</p>
        {% elsif form.errors %}
          <div style="color: #D32F2F; margin-bottom: 20px;">
             {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <!-- Full Name -->
        <div class="cbs-form-group">
          <label class="cbs-label" for="ContactFormName">Full name <span class="cbs-req">*</span></label>
          <input type="text" id="ContactFormName" name="contact[name]" class="cbs-input" placeholder="Your name here" required>
        </div>

        <!-- Email -->
        <div class="cbs-form-group">
          <label class="cbs-label" for="ContactFormEmail">Email <span class="cbs-req">*</span></label>
          <input type="email" id="ContactFormEmail" name="contact[email]" class="cbs-input" placeholder="E.g. myemail@email.com" required>
        </div>

        <!-- Phone -->
        <div class="cbs-form-group">
          <label class="cbs-label" for="ContactFormPhone">Phone number</label>
          <input type="tel" id="ContactFormPhone" name="contact[phone]" class="cbs-input" placeholder="E.g. 555 444 0755">
        </div>

        <!-- Message -->
        <div class="cbs-form-group">
          <label class="cbs-label">Tell us more about this project <span class="cbs-req">*</span></label>
          <textarea rows="4" name="contact[body]" class="cbs-textarea" placeholder="What do we need to know about the project?" required></textarea>
        </div>

        <button type="submit" class="cbs-submit">Send Message</button>

      {% endform %}
    </div>

  </div>
</div>