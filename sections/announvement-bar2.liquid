<script>
{% comment %} (function announcementBarCountdown() {

  // ⏱ START TIME FROM SCHEMA
  let totalSeconds =
    ({{ section.settings.start_hours | default: 0 }} * 3600) +
    ({{ section.settings.start_minutes | default: 0 }} * 60);

  let started = false;

  function startTimer() {
    if (started || totalSeconds <= 0) return;
    started = true;

    const section = document.getElementById('shopify-section-{{ section.id }}');
    const hEls = document.querySelectorAll('[id^="h-"]');
    const mEls = document.querySelectorAll('[id^="m-"]');

    if (!section || !mEls.length) return;

    function updateUI() {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);

      hEls.forEach(el => el.textContent = String(hours).padStart(2, '0'));
      mEls.forEach(el => el.textContent = String(minutes).padStart(2, '0'));
    }

    updateUI();

    const interval = setInterval(() => {
      totalSeconds--;

      if (totalSeconds <= 0) {
        clearInterval(interval);

        hEls.forEach(el => el.textContent = '00');
        mEls.forEach(el => el.textContent = '00');

        section.style.transition = 'opacity 0.4s ease';
        section.style.opacity = '0';

        setTimeout(() => {
          section.style.display = 'none';
        }, 400);

        return;
      }

      updateUI();
    }, 1000);
  }

  setTimeout(startTimer, 500);
  setTimeout(startTimer, 1500);
  setTimeout(startTimer, 3000);

})(); {% endcomment %}
{% comment %} (function () {

  function startTimer(block) {
