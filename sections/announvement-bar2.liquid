  setTimeout(init, 3000);

})(); {% endcomment %}

(function () {

  // ⏰ SHOW BETWEEN 8:00 AM – 1:00 PM PST
  const START_HOUR = 8;
  const END_HOUR = 11:10;

  function isWithinPSTWindow() {
    const now = new Date();

    // Convert to PST
    const pstTime = new Date(
      now.toLocaleString("en-US", { timeZone: "America/Los_Angeles" })
    );

    const hour = pstTime.getHours();
    const minute = pstTime.getMinutes();

    return hour >= START_HOUR && (hour < END_HOUR || (hour === END_HOUR && minute === 0));
  }

  function updateBlocks() {
    document.querySelectorAll('[data-clock-window]').forEach(block => {
      if (isWithinPSTWindow()) {
        block.classList.remove('clock-hidden');
      } else {
        block.classList.add('clock-hidden');
      }
    });
  }

  // Initial check
  updateBlocks();

  // Recheck every minute (auto start next day)
  setInterval(updateBlocks, 60000);

})();
</script>

