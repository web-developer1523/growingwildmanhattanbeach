{% schema %}
{
  "name": "Why Our Flowers Stand Out",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Why Our Flowers Stand Out"
    },
    {
      "type": "textarea",
      "id": "main_paragraph",
      "label": "Main Paragraph",
      "default": "Premium arrangements handcrafted with care using fresh, long-lasting blooms sourced daily."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Right Side Image"
    },
    {
        "type":"text",
        "id":"custom_css_class",
       "label":"Custom CSS Class",
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Feature Image"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "feature_text",
          "label": "Feature Text",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Flower Features Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}


<div class="flower-features-section {{ section.settings.custom_css_class }} page-width">
  <div class="main-container">
   <div class="main-head-sec">
   <h2>{{ section.settings.main_heading }}</h2>
      <p>{{ section.settings.main_paragraph }}</p>  
  </div>
  <div class="cst-bottom-area">
    <!-- Left side: Features -->
    <div class="features">
      {% for block in section.blocks %}
      <div class="feature-card">
        {% if block.settings.feature_image %}
          <img src="{{ block.settings.feature_image | img_url: 'medium' }}" alt="{{ block.settings.feature_title }}">
        {% endif %}
        <h4>{{ block.settings.feature_title }}</h4>
        <p>{{ block.settings.feature_text }}</p>
      </div>
      {% endfor %}
    </div>

    <!-- Right side: Main heading + paragraph + image -->
    <div class="main-content">
     
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | img_url: 'medium' }}" alt="{{ section.settings.main_heading }}">
      {% endif %}
    </div>
    </div>

  </div>
</div>

