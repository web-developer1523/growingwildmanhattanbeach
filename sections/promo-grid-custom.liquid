{%- comment -%}
  A responsive grid of promotional cards with text overlaid on images.
  - Up to 4 cards can be displayed.
  - Each card has a configurable image, title, subtitle, link, and text color.
{%- endcomment -%}

<style>
  .promo-grid-section {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .promo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Tablet and larger */
  @media screen and (min-width: 750px) {
    .promo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop and larger */
  @media screen and (min-width: 990px) {
    .promo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .promo-card {
    display: block;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    height: 450px; /* Default height */
    background-color: #f5f5f5;
  }

  .promo-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .promo-card:hover .promo-card__image {
    transform: scale(1.05);
  }

  .promo-card__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* Aligns text to the top */
    align-items: center;
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--text-color, #FFFFFF);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15); /* Improves text readability */
  }

  .promo-card__title {
    font-size: 1.75rem; /* 28px */
    font-weight: 500;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .promo-card__subtitle {
    font-size: 0.875rem; /* 14px */
    margin: 0 0 1.25rem;
    max-width: 25ch;
    line-height: 1.4;
  }

  .promo-card__link {
    font-size: 0.875rem; /* 14px */
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  
  .promo-card:hover .promo-card__link {
    border-bottom-color: var(--text-color, #FFFFFF);
  }
</style>

<div class="promo-grid-section">
  <div class="promo-grid page-width">
    {%- for block in section.blocks -%}
      <div class="promo-grid__item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}"
           class="promo-card"
           aria-label="Shop {{ block.settings.title | escape }}"
           style="--text-color: {{ block.settings.text_color }};">

          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag:
              class: 'promo-card__image',
              loading: 'lazy',
              widths: '300, 400, 500, 600, 800, 1000',
              sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 25vw'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'promo-card__image' }}
          {%- endif -%}

          <div class="promo-card__content">
            <h3 class="promo-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="promo-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
            <span class="promo-card__link">
              Shop Now →
            </span>
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Image Promo Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wellbeing Sets"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "With Supercharged Savings"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Promo Grid",
      "blocks": [
        {
          "type": "promo_card",
          "settings": {
            "title": "Wellbeing Sets",
            "subtitle": "With Supercharged Savings"
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Home Fragrance",
            "subtitle": "Scent your space... or theirs"
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Bestsellers",
            "subtitle": "Meet our heroes..."
          }
        },
        {
          "type": "promo_card",
          "settings": {
            "title": "Pod Starter Packs",
            "subtitle": "A size to suit every space and Essential Oil Blends to match"
          }
        }
      ]
    }
  ]
}
{% endschema %}