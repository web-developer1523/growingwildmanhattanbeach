{% schema %}
{
  "name": "Effortless Process",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6B7051"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number Color (Transparent)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Making it effortless"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Stress-Free Planning"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We guide you through style, colors, and vision to make floral planning easy, clear and enjoyable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Effortless Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Stress-Free Planning",
            "description": "We guide you through style, colors, and vision to make floral planning easy, clear and enjoyable."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Custom Floral Design",
            "description": "Every arrangement is tailored to your theme and venue, creating a cohesive look."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Delivery, Setup & Teardown",
            "description": "On event day we deliver, install, and remove florals so you simply relax and celebrate beautifully."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600&family=Inter:wght@300;400;600&display=swap');

  .ep-section {
    background-color: {{ section.settings.bg_color }};
    padding: 80px 20px;
    font-family: 'Larken', sans-serif;
    color: {{ section.settings.text_color }};
  }

  .ep-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  /* --- Left Column (Text) --- */
  .ep-text-col {
    flex: 1;
    max-width: 550px;
  }

  .ep-heading {
    font-family: 'Larken';
    font-size: 48px;
    font-weight: 600;
    margin-bottom: 50px;
    line-height: 1.1;
  }

  /* Process Steps List */
  .ep-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ep-step-item {
    display: flex;
    gap: 25px;
    padding: 30px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2); /* Thin divider line */
  }
  
  /* Remove border from last item if desired, though image shows lines 
  .ep-step-item:last-child { border-bottom: none; } */

  .ep-number {
    font-family: 'Inter', sans-serif;
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.number_color }};
    opacity: 0.15; /* Makes it look transparent/faded */
    min-width: 80px; /* Ensures alignment */
  }

  .ep-content {
    padding-top: 5px; /* Visual alignment with the big number */
  }

  .ep-step-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .ep-step-desc {
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
    font-weight: 300;
  }

  /* --- Right Column (Image) --- */
  .ep-img-col {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .ep-image {
    width: 100%;
    max-width: 550px;
    aspect-ratio: 1 / 1; /* Square-ish shape like image */
    object-fit: cover;
    border-radius: 20px;
    display: block;
    background-color: rgba(0,0,0,0.1);
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .ep-container {
      flex-direction: column;
      gap: 50px;
    }

    .ep-text-col {
      max-width: 100%;
    }

    .ep-heading {
      font-size: 36px;
      margin-bottom: 30px;
    }

    .ep-step-item {
      padding: 20px 0;
      gap: 15px;
    }

    .ep-number {
      font-size: 48px;
      min-width: 60px;
    }

    .ep-img-col {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<div class="ep-section">
  <div class="ep-container">
    
    <!-- Left Column: Text & Steps -->
    <div class="ep-text-col">
      <h2 class="ep-heading">{{ section.settings.heading }}</h2>

      <div class="ep-steps">
        {% for block in section.blocks %}
          <div class="ep-step-item" {{ block.shopify_attributes }}>
            <div class="ep-number">{{ block.settings.number }}</div>
            <div class="ep-content">
              <h3 class="ep-step-title">{{ block.settings.title }}</h3>
              <p class="ep-step-desc">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="ep-img-col">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'ep-image', loading: 'lazy' }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ep-image' }}
      {% endif %}
    </div>

  </div>
</div>