{% schema %}
{
  "name": "Floral Why Us Section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Page Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Main Heading",
      "default": "Why clients love planning\nflorals with us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Sub Description",
      "default": "Effortless planning, expert setup, and florals that transform your celebration."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Plan My Event Florals"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Color",
      "default": "#6B7051"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Delivery & Setup Included"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Text",
          "default": "We install florals on-site and return for teardown after your event."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Floral Why Us Section",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Delivery & Setup Included",
            "text": "We install florals on-site and return for teardown after your event."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Hassle-Free Planning",
            "text": "Flexible scheduling, fast proposals, and easy communication every step of the way."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Stunning, Photo-Ready Florals",
            "text": "Designed to look breathtaking in person and in your event photos."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600&family=Inter:wght@300;400;500;600&display=swap');

  .fwu-section {
    background-color: {{ section.settings.section_bg }};
    padding: 60px 20px;
    font-family: 'Larken', sans-serif;
  }

  .fwu-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    /* Desktop Height */
    min-height: 600px; 
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background Image Styling */
  .fwu-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .fwu-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .fwu-bg-placeholder {
    width: 100%;
    height: 100%;
    background-color: #2c2c2c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The Floating White Card */
  .fwu-card {
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    width: 90%;
    max-width: 1000px;
    border-radius: 12px;
    padding: 50px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }

  /* Header */
  .fwu-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; 
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #E5E5E5; 
    gap: 40px;
  }

  .fwu-header-content {
    max-width: 600px;
  }

  .fwu-title {
    font-family: 'Larken', serif !important;
    font-size: 42px;
    line-height: 1.1;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 20px 0;
  }

  .fwu-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  .fwu-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: #fff;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    transition: opacity 0.3s;
    flex-shrink: 0; 
    margin-top: 10px; 
  }

  .fwu-btn:hover {
    opacity: 0.9;
  }

  /* Grid */
  .fwu-grid {
    display: flex;
    justify-content: space-between;
    gap: 30px;
  }

  .fwu-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fwu-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 15px;
    object-fit: contain;
  }
  
  .fwu-icon svg {
    width: 100%;
    height: 100%;
    stroke: #1a1a1a; 
    stroke-width: 1.5;
    fill: none;
  }

  .fwu-item-title {
    font-size: 16px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 10px 0;
    font-family: 'Larken', sans-serif;
  }

  .fwu-item-text {
    font-size: 13px;
    line-height: 1.5;
    color: #666;
    margin: 0;
  }

  /* --- MOBILE RESPONSIVE FIXES --- */
  @media (max-width: 768px) {
    .fwu-section {
      /* Remove side padding on the section so image can go full width */
      padding: 0 0 60px 0; 
    }

    .fwu-container {
      display: block; /* Switch from flex to block for stacking */
      min-height: auto;
      border-radius: 0;
    }

    .fwu-bg {
      position: relative; /* Make relative so it pushes content down */
      width: 100%;
      height: 300px; /* Taller height for mobile banner look */
      border-radius: 0;
    }

    .fwu-card {
      width: 90%; /* 90% width looks better than 100% touching edges */
      margin: -80px auto 0 auto; /* Pull card UP over the image */
      padding: 30px 25px;
      border-radius: 12px;
      z-index: 5;
    }

    .fwu-card-header {
      flex-direction: column;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 30px;
      padding-bottom: 30px;
    }
    
    .fwu-title {
      font-size: 32px;
    }
    
    .fwu-btn {
        width: 100%;
        text-align: center;
    }

    .fwu-grid {
      flex-direction: column;
      gap: 35px;
    }
  }
{% endstyle %}

<div class="fwu-section">
  <div class="fwu-container">
    
    <!-- Background Image -->
    <div class="fwu-bg">
      {% if section.settings.bg_image %}
        {{ section.settings.bg_image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
      {% else %}
        <!-- Dark placeholder if no image -->
        <div class="fwu-bg-placeholder"></div>
      {% endif %}
    </div>

    <!-- White Content Card -->
    <div class="fwu-card">
      
      <!-- Header Row -->
      <div class="fwu-card-header">
        <div class="fwu-header-content">
          <h2 class="fwu-title">{{ section.settings.title }}</h2>
          <p class="fwu-desc">{{ section.settings.description }}</p>
        </div>
        
        {% comment %} Button hidden if link is empty {% endcomment %}
        {% if section.settings.btn_link != blank %}
          <a href="{{ section.settings.btn_link }}" class="fwu-btn">{{ section.settings.btn_text }}</a>
        {% endif %}
      </div>

      <!-- Features Grid -->
      <div class="fwu-grid">
        {% for block in section.blocks %}
          <div class="fwu-item" {{ block.shopify_attributes }}>
            
            <!-- Icon Logic -->
            <div class="fwu-icon">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url: width: 60 }}" alt="" style="width:100%;height:100%;">
              {% else %}
                <!-- Hardcoded SVGs -->
                {% if forloop.index == 1 %}
                   <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                {% elsif forloop.index == 2 %}
                   <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                {% else %}
                   <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {% endif %}
              {% endif %}
            </div>

            <h3 class="fwu-item-title">{{ block.settings.title }}</h3>
            <p class="fwu-item-text">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</div>