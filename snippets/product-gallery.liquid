}
</style>

<script>
(function() {
  function initReviewSliders() {
    document.querySelectorAll('.product-review-slider[data-review-slider]').forEach(function(wrapper) {
      var track = wrapper.querySelector('.product-review-slider__track');
      var slides = wrapper.querySelectorAll('.product-review-slider__slide');
      var dotsEl = wrapper.querySelector('.product-review-slider__dots');
      if (!track || !slides.length || !dotsEl) return;
      var total = slides.length;
      var current = 0;
      function updateTrackHeight() {
        var active = wrapper.querySelector('.product-review-slider__slide.is-active');
        if (active) track.style.height = active.offsetHeight + 'px';
      }
      function goTo(index) {
        current = (index + total) % total;
        slides.forEach(function(s, i) { s.classList.toggle('is-active', i === current); });
        dotsEl.querySelectorAll('button').forEach(function(b, i) { b.classList.toggle('is-active', i === current); });
        requestAnimationFrame(updateTrackHeight);
      }
      slides.forEach(function(s, i) { s.classList.toggle('is-active', i === 0); });
      updateTrackHeight();
      if (window.ResizeObserver) {
        new ResizeObserver(updateTrackHeight).observe(track);
      }
      dotsEl.style.display = total <= 1 ? 'none' : 'flex';
      for (var i = 0; i < total; i++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        btn.classList.toggle('is-active', i === 0);
        (function(idx) { btn.addEventListener('click', function() { goTo(idx); }); })(i);
        dotsEl.appendChild(btn);
      }
      var autoplayMs = 5000;
      var autoplayId = setInterval(function() { goTo(current + 1); }, autoplayMs);
      wrapper.addEventListener('mouseenter', function() { clearInterval(autoplayId); });
      wrapper.addEventListener('mouseleave', function() { autoplayId = setInterval(function() { goTo(current + 1); }, autoplayMs); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewSliders);
  } else {
    initReviewSliders();
  }
})();
</script>
