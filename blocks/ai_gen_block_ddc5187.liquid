  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Title",
      "default": "Welcome to our store!"
    },
    {
      "type": "richtext",
      "id": "popup_content",
      "label": "Content",
