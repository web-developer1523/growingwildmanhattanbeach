    "faq_hcnPaE": {
      "type": "faq",
      "blocks": {
        "question_dDtRrP": {
          "type": "question",
          "settings": {
            "question": "<strong>What types of flowers can I send in El Segundo?</strong>",
            "answer": "<p>Growing Wild offers a wide selection of flowers, including roses, lilies, tulips, seasonal bouquets, potted plants, and custom arrangements for any occasion.</p>"
          }
        },
        "question_rNygrM": {
          "type": "question",
          "settings": {
            "question": "<strong>Can flowers be delivered to businesses, hospitals, or hotels in El Segundo?</strong>",
            "answer": "<p>Absolutely! Growing Wild delivers to homes, offices, hospitals, hotels, and event venues throughout El Segundo and nearby areas.</p>"
          }
        },
        "question_TLehbd": {
          "type": "question",
          "settings": {
            "question": "<strong>What if the recipient isn’t available at delivery?</strong>",
            "answer": "<p>If the recipient is unavailable, Growing Wild may call them, leave the flowers in a safe location, notify you, or reschedule the delivery at no extra charge.</p>"
          }
        },
        "question_ttDVDa": {
          "type": "question",
          "settings": {
            "question": "<strong>Will my flowers look exactly like the online picture?</strong>",
            "answer": "<p>Growing Wild strives to match the online images, but bouquets may vary slightly due to seasonal availability or substitutions with blooms of equal or higher value.</p>"
          }
        },
        "question_MAkLEA": {
          "type": "question",
          "settings": {
            "question": "<strong>Can I order flowers online from outside the U.S. for delivery in El Segundo?</strong>",
            "answer": "<p>Yes, you can order from anywhere in the world through Growing Wild’s website for fast and reliable flower delivery in El Segundo.</p>"
          }
        }
      },
