        "heading_fnDirC": {
          "type": "heading",
          "settings": {
            "text": "<strong>Why Choose Our Flower Shop El Segundo CA</strong>",
            "heading_tag": "h2"
          }
        },
        "richtext_yB3EtJ": {
          "type": "richtext",
          "settings": {
            "content": "<p>We’re committed to delivering fresh, high-quality flowers with creativity and care. Every order, from a one-time bouquet to regular deliveries, is handled with attention to make your experience special.</p><p><strong>Expert Florists</strong></p><ul><li>Local florists craft each arrangement with skill and precision</li><li>Designs that blend artistry with elegance</li><li>Every bouquet gets careful attention to detail</li></ul><p><strong>Affordable Options</strong></p><ul><li>Beautiful flowers for any budget</li><li>Quality that doesn’t compromise value</li><li>Special deals and seasonal offers</li></ul><p><strong>Floral Subscriptions</strong></p><ul><li>Regular flower delivery for your home or office</li><li>Choose how often and what style suits you</li><li>Simple, convenient, and reliable service</li></ul><p><strong>Seasonal & Stylish Arrangements</strong></p><ul><li>Collections refreshed for holidays and seasonal trends</li><li>Designs from modern to classic to natural</li><li>Keeps your space or event looking vibrant and on-trend</li></ul>"
          }
