          }
        },
        "richtext_NNRTae": {
          "type": "richtext",
          "settings": {
            "content": "<p>We're not some national company shipping wilted flowers across the country. We're local florists who care about quality. Your flowers are fresh when they arrive, not beaten up from shipping.</p><p>What same-day delivery means for you:</p><ul><li>Flowers arrive hours after being made</li><li>Delivered exactly when you scheduled</li><li>Actually fresh, not \"fresh\"</li><li>Made by local florists who care about every delivery</li></ul>"
          }
