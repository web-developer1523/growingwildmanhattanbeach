            "heading_tag": "h2"
          }
        },
        "richtext_hT6Xga": {
          "type": "richtext",
          "settings": {
            "content": "<p>Want specific colors for your living room? Prefer certain flowers over others? Need arrangements that fit your vase collection? We customize every subscription to match what you actually want. Not stuck with whatever we feel like making. Our team makes it happen with dedication and love.</p><p>What you can customize:</p><ul><li>Colors that match your home decor perfectly</li><li>Specific flowers you love or want to avoid</li><li>Arrangement size based on your space</li><li>Delivery day that works for your schedule</li></ul>"
          }
        }
      },
