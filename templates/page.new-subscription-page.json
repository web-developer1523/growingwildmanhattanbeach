    "faq_3Fi69E": {
      "type": "faq",
      "blocks": {
        "question_zeNncz": {
          "type": "question",
          "settings": {
            "question": "<strong>How often will I receive flowers with a subscription?</strong>",
            "answer": "<p>You choose your delivery frequency when ordering. <em>Weekly flower subscription services</em> deliver every 7 days, fresh flowers biweekly subscription arrives every 14 days, and monthly flower subscription services deliver once per month.</p>"
          }
        },
        "question_4Yiy8Q": {
          "type": "question",
          "settings": {
            "question": "<strong>Can I cancel my flower subscription anytime?</strong>",
            "answer": "<p>Yes, cancel anytime after your first delivery with zero penalties. Contact us or manage your subscription online through your account.</p>"
          }
        },
        "question_jwa7dK": {
          "type": "question",
          "settings": {
            "question": "<strong>Can I send a flower subscription as a gift?</strong>",
            "answer": "<p>Absolutely, flower subscriptions make perfect gifts that keep giving for months. Order online and we'll deliver to them on your schedule with 3-month, 6-month, or 12-month options available.</p>"
          }
        },
        "question_RtPTAY": {
          "type": "question",
          "settings": {
            "question": "<strong>Can I change my delivery address?</strong>",
            "answer": "<p>Yes, update your delivery address anytime through your account or by calling us. Perfect for sending flowers to different people or places throughout your subscription.</p>"
          }
        },
        "question_AKXzRA": {
          "type": "question",
          "settings": {
            "question": "<strong>What flowers will I get in my subscription?</strong>",
            "answer": "<p>Each delivery includes seasonal blooms that our designers select that morning based on your requirements. You get variety throughout the year with different flowers each delivery.</p>"
          }
        }
      },
