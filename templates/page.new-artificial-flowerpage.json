    "image_with_text_NzrDyp": {
      "type": "image-with-text",
      "blocks": {
        "heading_pPCJdn": {
          "type": "heading",
          "settings": {
            "text": "<strong>Who Needs Custom Artificial Flower Arrangements?</strong>",
            "heading_tag": "h2"
          }
        },
        "richtext_QBDkdf": {
          "type": "richtext",
          "settings": {
            "content": "<p>If you've ever thought, \"<em>I wish my place had flowers, but I can't keep up with them</em>,\" this is for you.</p><p>Who gets custom pieces from us:</p><ul><li>Professionals are tired of bare offices</li><li>People who actually can't breathe around real flowers</li><li>Homeowners are done with the death cycle</li><li>Wedding couples avoiding day-of disasters</li><li>Anyone who travels constantly</li><li>Parents who have enough to keep themselves alive already</li></ul>"
          }
