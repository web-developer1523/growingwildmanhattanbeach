    "faq_ECeBfU": {
      "type": "faq",
      "blocks": {
        "question_RcncqF": {
          "type": "question",
          "settings": {
            "question": "Can I get same-day delivery if I order before 1 PM?",
            "answer": "<h3></h3><p>Yes! If you place your order before 1 PM, we can deliver your flowers the same day. We take pride in ensuring your arrangements arrive quickly and beautifully. </p>"
          }
        },
        "question_Eq8EyK": {
          "type": "question",
          "settings": {
            "question": "I don’t know much about flowers. Can you help me choose the right one?",
            "answer": "<p>Of course! Whether you have a specific idea or need guidance, we’re happy to help you choose the perfect arrangement for any occasion. Just let us know what you’re looking for, and we’ll take care of the rest. You can always reach us at <strong>310-545-4432</strong> for assistance.</p>"
          }
        },
        "question_pRbcLc": {
          "type": "question",
          "settings": {
            "question": "How fresh are your flowers?",
            "answer": "<h3></h3><p>Our flowers are delivered fresh daily to ensure they’re at their best when they arrive at your door. We guarantee the highest quality and longest-lasting blooms. </p>"
          }
        },
        "question_Cwkapd": {
          "type": "question",
          "settings": {
            "question": "Do you offer custom designs?",
            "answer": "<h3></h3><p>Yes, we love creating custom designs! If you have something special in mind or want to tailor an arrangement to your needs, let us know, and we’ll craft something unique just for you. Feel free to call us at <strong>310-545-4432</strong> to discuss your ideas.</p>"
          }
        },
        "question_kxfyAd": {
          "type": "question",
          "settings": {
            "question": "Are you a local florist?",
            "answer": "<p>Yes, we are! Growing Wild has been serving Manhattan Beach and the surrounding areas for over 30 years. We’re proud to be your local florist with a commitment to quality and personal service. </p>"
          }
        },
        "question_nreanA": {
          "type": "question",
          "settings": {
            "question": "<strong>How long do your flower arrangements stay fresh?</strong>",
            "answer": "<p>We offer a wide range of flower arrangements including birthday, wedding, anniversary, sympathy, and seasonal designs, all created with fresh, high-quality flowers.</p>"
          }
        },
        "question_nAqwDq": {
          "type": "question",
          "settings": {
            "question": "<strong>What types of flower arrangements do you offer?</strong>",
            "answer": "<p><br/> We offer a wide range of flower arrangements including birthday, wedding, anniversary, sympathy, and seasonal designs, all created with fresh, high-quality flowers.<br/><br/></p>"
          }
        }
      },
