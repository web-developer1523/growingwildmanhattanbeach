    "custom_rich_text_NRXcPr": {
      "type": "custom-rich-text",
      "blocks": {
        "heading_7fPaGe": {
          "type": "heading",
          "settings": {
            "text": "<strong>Why Choose Growing Wild in Hermosa Beach?</strong>",
            "heading_tag": "h2",
            "font_size_desktop": 48,
            "font_size_mobile": 32,
            "font_family": "Larken"
          }
        },
        "richtext_8TQDfK": {
          "type": "richtext",
          "settings": {
            "content": "<p><a href=\"https://growingwildmanhattanbeach.com/\" title=\"https://growingwildmanhattanbeach.com/\"><em>Growing Wild</em></a><em> </em>designs speak through color, texture, and meaning. From soft pastel tones to bold seasonal palettes, each bouquet tells a story. As a <strong>local flower shop Hermosa Beach</strong>, we source directly from trusted growers, hand-selecting each stem for its beauty and longevity. Our flowers reflect a commitment to craftsmanship and emotional connection. We create <a href=\"/collections/arrangements\" title=\"Arrangements\">arrangements</a> that express the feelings you want to share.</p>"
          }
        }
      },
      "block_order": [
        "heading_7fPaGe",
        "richtext_8TQDfK"
      ],
      "custom_css": [
        ".prose a {color: rgb(255, 42, 0) !important; font-weight: 800;}"
      ],
      "name": "Custom Rich Text",
      "settings": {
