    "testimonials_v2_G4LpJz": {
      "type": "testimonials-v2",
      "blocks": {
        "testimonials_block_gArKaX": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/avtar.png",
            "z_review": "I ordered flowers for same-day delivery and Growing Wild nailed it. The flowers looked amazing and they made sure to delivery the flowers before my wife left work. Thank you!",
            "z_author": "Patrick R.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_DdwCxL": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/female-placeholder_12548d72-5cfa-4a3a-a455-2aa97a0f63d0.png",
            "z_review": "The orchids that I sent my niece were absolutely stunning! Way above and beyond my expectations! Thank you so much for taking care of my gift so perfectly!",
            "z_author": "Janet M.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_NpqWJc": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/woman-avatar-photo-placeholder-icon-hairstyle-two-ponytails-vector.png",
            "z_review": "Order was easy, delivery was fast, and product was beautiful!\nGrowing Wild is definitely my \"go-to\" flower shop in Manhattan Beach!",
            "z_author": "Amy G.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_ERw7Ez": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/placeholder-woman.webp",
            "z_review": "My daughter was thrilled with this arrangement. I wish I were with her to enjoy it. I have kept your name in my address book for many years just for special occasions.\nGood work!",
            "z_author": "Anne B.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_CQyJKh": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/female-placeholder_12548d72-5cfa-4a3a-a455-2aa97a0f63d0.png",
            "z_review": "Arrived very quickly and the arrangement itself is gorgeous. I got this as a gift for my mother and she absolutely loved it!",
            "z_author": "Anna S.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_tdN8iD": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/avtar.png",
            "z_review": "First time ordering with Growing Wild and I loved what they put together for an anniversary gift for friends. Highly recommend!",
            "z_author": "Devin L.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_qqMX7P": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/female-placeholder_12548d72-5cfa-4a3a-a455-2aa97a0f63d0.png",
            "z_review": "This arrangement is beautiful!! I have it myself. I was a perfect gift for my good friend whose mom passed away. I love the ease of ordering and the delivery too.",
            "z_author": "Susan A.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_pURVLb": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/avtar.png",
            "z_review": "Amazing arrangement, delivered with care and exceeded expectations! The picture can't to it justice, the arrangement, quality and service were first class!",
            "z_author": "Adam C.",
            "z_post_name": "Verified Reviews"
          }
        }
