        "heading_zkz76m": {
          "type": "heading",
          "settings": {
            "text": "<strong>Our Signature Floral Collections</strong>",
            "heading_tag": "h2"
          }
        },
        "richtext_AnJE7L": {
          "type": "richtext",
          "settings": {
            "content": "<p>Our signature collections combine nature’s beauty with design mastery. Whether you prefer elegant classics or modern garden styles, our arrangements complement the mood and season.</p><p><strong>Our Popular Categories Include:</strong></p><ul><li><strong>Luxury Bouquets:</strong> Sophisticated, statement-making blooms</li><li><strong>Seasonal Arrangements:</strong> Rotating designs with the best flowers of the month</li><li><strong>Wildflower Mixes:</strong> Free-spirited and naturally charming</li><li><strong>Succulent & Plant Designs:</strong> Long-lasting greenery with a modern twist</li><li><strong>Event Florals:</strong> Tailored creations for weddings, anniversaries, and gatherings</li></ul>"
          }
        },
