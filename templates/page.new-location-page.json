    "image_with_text_XNncP9": {
      "type": "image-with-text",
      "blocks": {
        "heading_eHwm9R": {
          "type": "heading",
          "settings": {
            "text": "<strong>100% Fresh Quality Guaranteed</strong>",
            "heading_tag": "h2"
          }
        },
        "richtext_XwQmzf": {
          "type": "richtext",
          "settings": {
            "content": "<p>Freshness defines everything we do. Each bloom comes straight from the farm and is handled under ideal conditions to maintain its vibrancy. We create <a href=\"/collections/arrangements\" title=\"Arrangements\">arrangements </a>that express the feelings and meaning you want to share.</p><p><strong>Popular Picks:</strong></p><ul><li><a href=\"/products/1-dosen-roses-medium-size\" title=\"1 dosen roses, medium size\"><strong>Roses</strong></a><strong> </strong>in classic and contemporary shades</li><li><strong>Tulips </strong>bursting with spring energy</li><li><strong>Wildflowers </strong>blended for a natural touch</li><li><strong>Hydrangeas </strong>for full, elegant displays</li><li><a href=\"/products/wild-flowers-with-sunflowers\" title=\"Wild Flowers with Sunflowers\"><strong>Sunflowers</strong></a><strong> </strong>that bring warmth to any space</li><li>& so many more! </li></ul>"
          }
        },
        "button_iHMdEh": {
          "type": "button",
          "settings": {
            "style": "solid",
            "text": "Call Now",
            "url": "tel:(310) 545-4432",
            "background": "",
            "text_color": ""
          }
        }
      },
      "block_order": [
        "heading_eHwm9R",
        "richtext_XwQmzf",
        "button_iHMdEh"
      ],
      "custom_css": [
