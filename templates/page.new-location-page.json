    "faq_hcnPaE": {
      "type": "faq",
      "blocks": {
        "question_dDtRrP": {
          "type": "question",
          "settings": {
            "question": "<strong>What types of flowers are popular for delivery in Hermosa Beach?</strong>",
            "answer": "<p>Popular flowers for delivery include roses, lilies, tropical varieties, seasonal arrangements, and custom bouquets tailored to specific occasions.</p>"
          }
        },
        "question_rNygrM": {
          "type": "question",
          "settings": {
            "question": "<strong>How do you keep flowers fresh during delivery?</strong>",
            "answer": "<p>Flowers are prepared the same day as delivery and wrapped to retain moisture. Our drivers handle bouquets carefully so they arrive vibrant and fresh.</p>"
          }
        },
        "question_TLehbd": {
          "type": "question",
          "settings": {
            "question": "<strong>Will my flowers look like the picture online?</strong>",
            "answer": "<p>Florists strive to match the online images, but designs may differ slightly based on seasonal flower availability and custom requests.</p>"
          }
        },
        "question_ttDVDa": {
          "type": "question",
          "settings": {
            "question": "<strong>Can I schedule flower delivery in advance?</strong>",
            "answer": "<p>Yes, you can choose the exact delivery date for birthdays, Mother’s Day, anniversaries, or other special events.</p>"
          }
        },
        "question_MAkLEA": {
          "type": "question",
          "settings": {
            "question": "<strong>How do I place an order for Hermosa Beach flower delivery?</strong>",
            "answer": "<p>Order online or by phone, select your bouquet, add personalization, choose the delivery date, and confirm payment. We handle the rest.</p>"
          }
        }
      },
