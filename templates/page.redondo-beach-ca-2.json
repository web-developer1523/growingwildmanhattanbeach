          }
        },
        "richtext_8KGmgJ": {
          "type": "richtext",
          "settings": {
            "content": "<p>Our signature ranges showcase distinct styles from refined to relaxed natural beauty. Each collection features flowers at their finest, perfectly suited to different moods and moments.</p><p><strong>Browse Our Selections:</strong></p><ul><li><a href=\"/collections/bouquet\" title=\"Bouquet\"><strong>Luxury Bouquets:</strong> </a>Premium blooms making powerful statements</li><li><a href=\"/collections/arrangements\" title=\"Arrangements\"><strong>Seasonal Arrangements:</strong></a> Fresh designs rotating with nature's calendar</li><li><strong>Wildflower Mixes:</strong> Unstructured beauty with effortless appeal</li><li><a href=\"/collections/plants\" title=\"Plants\"><strong>Succulent & Plant Designs:</strong></a> Enduring greenery with modern flair</li><li><a href=\"/pages/weddings-events\" title=\"Weddings & Events\"><strong>Event Florals:</strong></a> Custom creations for weddings, celebrations, and corporate gatherings<br/><br/></li></ul>",
            "testimonial_text": "The attention to detail is stunning every bouquet felt like a piece of art. They made our event unforgettable.",
