        "richtext_yB3EtJ": {
          "type": "richtext",
          "settings": {
            "content": "<p>At <a href=\"https://growingwildmanhattanbeach.com/\" title=\"https://growingwildmanhattanbeach.com/\">Growing Wild</a>, we focus on quality, creativity, and making every customer feel valued. From your first bouquet to recurring deliveries, we make sure every experience is special.</p><p><strong>Experienced Florists</strong></p><ul><li>Local florists create each arrangement with care and skill</li><li>Bouquets that combine artistry with elegance</li><li>Every flower gets thoughtful attention to detail</li></ul><p><strong>Affordable Options</strong></p><ul><li><a href=\"/collections/arrangements\" title=\"Arrangements\">Beautiful arrangements</a> to suit all budgets</li><li>High-quality flowers without compromise</li><li>Seasonal deals and special promotions</li></ul><p><a href=\"/pages/subscriptions\" title=\"Subscriptions\"><strong>Multiple Subscriptions</strong></a></p><ul><li>Regular flower delivery for homes or offices</li><li>Choose the frequency and bouquet style that fits your needs</li><li>Easy, convenient, and stress-free service</li></ul><p><strong>Seasonal & Stylish Designs</strong></p><ul><li>Collections updated to match seasons and holidays</li><li>Designs ranging from modern to classic to natural</li><li>Keeps your home, office, or event looking fresh and on-trend</li></ul>",
            "testimonial_text": "The attention to detail is stunning every bouquet felt like a piece of art. They made our event unforgettable.",
            "testimonial_name": "",
            "stars": 5
          }
        },
