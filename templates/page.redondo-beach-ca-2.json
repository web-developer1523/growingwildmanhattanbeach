    "custom_rich_text_NRXcPr": {
      "type": "custom-rich-text",
      "blocks": {
        "heading_7fPaGe": {
          "type": "heading",
          "settings": {
            "text": "<strong>Years of Delivering Fresh Flowers To Your Doorsteps</strong>",
            "heading_tag": "h2",
            "font_size_desktop": 48,
            "font_size_mobile": 32,
            "font_family": "Larken"
          }
        },
        "richtext_8TQDfK": {
          "type": "richtext",
          "settings": {
            "content": "<p>Based in Manhattan Beach and proudly serving Redondo Beach, Growing Wild creates <a href=\"/collections/arrangements\" title=\"Arrangements\">arrangements </a>that carry purpose. Colors blend with textures to form pieces that communicate emotions beyond language. As a dedicated flower shop in Redondo Beach CA, <a href=\"https://growingwildmanhattanbeach.com/\" title=\"https://growingwildmanhattanbeach.com/\">Growing Wild</a> maintains direct partnerships with growers who share our quality standards. Each stem is chosen for its vitality and visual appeal. When moments matter most, our florals deliver authenticity and artistry that resonates long after delivery.</p>"
          }
        }
      },
      "block_order": [
        "heading_7fPaGe",
        "richtext_8TQDfK"
      ],
      "custom_css": [
        ".prose a {color: rgb(255, 42, 0) !important; font-weight: 800;}"
