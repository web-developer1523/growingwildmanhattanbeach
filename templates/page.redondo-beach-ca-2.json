    "image_with_text_XNncP9": {
      "type": "image-with-text",
      "blocks": {
        "heading_eHwm9R": {
          "type": "heading",
          "settings": {
            "text": "<strong>100% Premium Quality You Can Rely On</strong>",
            "heading_tag": "h2"
          }
        },
        "richtext_XwQmzf": {
          "type": "richtext",
          "settings": {
            "content": "<p>Quality begins at the source. Blooms arrive directly from growers and receive careful handling to preserve their natural beauty. Our arrangements showcase flowers at their peak, designed to convey the emotions you want to express.</p><p><strong>What We Offer:</strong></p><ul><li>Roses in both traditional and modern varieties</li><li>Tulips radiating seasonal brilliance</li><li>Wildflowers arranged for organic charm</li><li>Hydrangeas create lush, romantic statements</li><li>Sunflowers deliver instant cheerfulness</li></ul>",
            "testimonial_text": "The attention to detail is stunning every bouquet felt like a piece of art. They made our event unforgettable.",
            "testimonial_name": "",
            "stars": 5
          }
        }
      },
      "block_order": [
        "heading_eHwm9R",
