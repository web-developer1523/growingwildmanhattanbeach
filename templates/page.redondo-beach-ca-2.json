            "Stars": "5",
            "z_img": "shopify://shop_images/woman-avatar-photo-placeholder-icon-hairstyle-two-ponytails-vector.png",
            "z_review": "Order was easy, delivery was fast, and product was beautiful!\nGrowing Wild is definitely my \"go-to\" flower shop in Manhattan Beach!",
            "z_author": "Amy G.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_ERw7Ez": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/placeholder-woman.webp",
            "z_review": "My daughter was thrilled with this arrangement. I wish I were with her to enjoy it. I have kept your name in my address book for many years just for special occasions.\nGood work!",
            "z_author": "Anne B.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_CQyJKh": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/female-placeholder_12548d72-5cfa-4a3a-a455-2aa97a0f63d0.png",
            "z_review": "Arrived very quickly and the arrangement itself is gorgeous. I got this as a gift for my mother and she absolutely loved it!",
            "z_author": "Anna S.",
            "z_post_name": "Verified Reviews"
          }
        },
        "testimonials_block_tdN8iD": {
          "type": "testimonials_block",
          "settings": {
            "Stars": "5",
            "z_img": "shopify://shop_images/avtar.png",
